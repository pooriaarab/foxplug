{
  "name": "foxplug-agent",
  "version": "0.1.1",
  "description": "Private integrations for local-model browser agents: manifests, a pinned runner, and three planner tools.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/foxplug.git"
  },
  "homepage": "https://github.com/pooriaarab/foxplug#readme",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "foxgate": "^0.1.2",
    "foxshield": "^0.1.2",
    "foxtrail": "^0.1.2",
    "foxvault": "^0.1.2"
  }
}
